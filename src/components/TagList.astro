---
interface Props {
  items: string[];
  label: string;
}

const { items, label } = Astro.props;
---

<ul class="tag_list" aria-label={label}>
  {items.map((item) => <li class="tag_list_item">{item}</li>)}
</ul>

<style>
  .tag_list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
  }

  .tag_list_item {
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    line-height: var(--leading-small);
    padding: var(--space-1) var(--space-3);
  }
</style>
